# Copy to .env on the VPS (next to docker-compose.prod.yml). Never commit the real file.
GHCR_OWNER=31arthur          # lowercase GitHub user/org that owns the images
IMAGE_TAG=latest             # or a commit SHA / pinned tag to roll back
DOMAIN=api.example.com       # DNS A record must point at the VPS
POSTGRES_PASSWORD=
IDENTITY_DB_PASSWORD=
RECORDS_DB_PASSWORD=
JWT_SECRET=                  # openssl rand -hex 48
CORS_ORIGINS=["https://your-frontend.example.com"]
