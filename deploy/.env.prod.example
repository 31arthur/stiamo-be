# Copy to .env on the VPS next to docker-compose.yml. Never commit the real file.
GHCR_OWNER=31arthur          # lowercase GitHub owner of the stiamo-be repo (where the images are published)
IMAGE_TAG=latest             # or a short commit SHA to pin / roll back
POSTGRES_PASSWORD=
IDENTITY_DB_PASSWORD=
RECORDS_DB_PASSWORD=
PRACTICE_DB_PASSWORD=
FILES_DB_PASSWORD=
AGENT_DB_PASSWORD=
JWT_SECRET=                  # openssl rand -hex 48
CORS_ORIGINS=https://your-frontend.example.com   # comma-separated, no quotes/brackets needed
# ALLOW_REGISTRATION=true     # off by default: anyone could otherwise create an account through the API
# AI agent and chat channels (docs/AGENT_SETUP.md)
# AGENT_SECRET_KEY=          # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# AGENT_PUBLIC_URL=https://stiamo-be.fullstackarthur.com
# Google Drive search (docs/DRIVE_SETUP.md)
# DRIVE_FOLDER_ID=            # the shared Letters folder's id
# DRIVE_ALLOWED_EMAILS=       # the email you sign in to Stiamo with
