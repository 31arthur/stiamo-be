IDENTITY_ENV=development
IDENTITY_DATABASE_URL=postgresql+asyncpg://stiamo:stiamo@localhost:5432/stiamo_identity
# HS256 (simple): the same secret must be set as RECORDS_JWT_SECRET
IDENTITY_JWT_SECRET=change-me-to-a-long-random-string
# RS256 (recommended across services): set IDENTITY_JWT_ALGORITHM=RS256, the private key here only,
# and the public key in every other service.
IDENTITY_ACCESS_TTL_MINUTES=15
IDENTITY_REFRESH_TTL_DAYS=30
IDENTITY_CORS_ORIGINS=["http://localhost:5173"]
