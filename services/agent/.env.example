AGENT_ENV=development
AGENT_DATABASE_URL=sqlite+aiosqlite:///./agent.db
AGENT_JWT_SECRET=change-me-to-the-same-secret-as-identity
# Encrypts the AI provider keys and channel tokens stored in the database. Required in production.
# Generate one:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AGENT_SECRET_KEY=
# The public address of the API, so Telegram and Twilio can reach the webhooks (https only).
AGENT_PUBLIC_URL=https://stiamo-be.example.com
# Where the other services are (inside the Docker network).
AGENT_PRACTICE_URL=http://practice:8000
AGENT_FILES_URL=http://files:8000
AGENT_DRIVE_URL=http://drive:8000
AGENT_CORS_ORIGINS=http://localhost:5173
