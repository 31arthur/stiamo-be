DRIVE_ENV=development
DRIVE_JWT_SECRET=change-me-to-the-same-secret-as-identity
# The service account's key file from Google Cloud (see docs/DRIVE_SETUP.md)
DRIVE_CREDENTIALS_FILE=./drive-credentials.json
# The shared "Letters" folder's id (the last part of its address in Drive on the web)
DRIVE_FOLDER_ID=
# Who may search: the email you sign in to Stiamo with. Empty means nobody.
DRIVE_ALLOWED_EMAILS=you@example.com
DRIVE_CORS_ORIGINS=http://localhost:5173
